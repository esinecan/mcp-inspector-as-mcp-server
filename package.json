{
  "name": "mcp-inspector-as-mcp-server",
  "version": "2.1.0",
  "description": "A lean MCP server that enables LLMs to inspect and test other MCP servers",
  "author": "Eren Sinecan",
  "repository": {
    "type": "git",
    "url": "https://github.com/esinecan/mcp-inspector-as-mcp-server"
  },
  "type": "module",
  "main": "dist/server.js",
  "files": [
    "dist/",
    "bin/",
    "LICENSE",
    "README.md"
  ],
  "bin": {
    "mcp-inspector": "dist/server.js",
    "mcp-steer": "bin/mcp-steer.mjs"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc -w",
    "start": "node dist/server.js",
    "clean": "rm -rf dist",
    "test": "vitest run",
    "test:cov": "vitest run --coverage",
    "lint": "eslint src/",
    "format": "prettier --write 'src/**/*.ts' 'bin/*.mjs'",
    "format:check": "prettier --check 'src/**/*.ts' 'bin/*.mjs'",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run lint && npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.24.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.17.0",
    "@vitest/coverage-v8": "^4.1.4",
    "eslint": "^10.2.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.8.2",
    "typescript": "^5.4.2",
    "typescript-eslint": "^8.58.1",
    "vitest": "^4.1.4"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "inspector",
    "testing",
    "debugging",
    "llm",
    "ai-agents"
  ],
  "license": "MIT"
}

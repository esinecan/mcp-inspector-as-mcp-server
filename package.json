{
  "name": "mcp-inspector-as-mcp-server",
  "version": "1.0.0",
  "description": "A lean MCP server that enables LLMs to inspect and test other MCP servers",
  "type": "module",
  "main": "dist/server.js",
  "bin": {
    "mcp-inspector": "dist/server.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc -w",
    "start": "node dist/server.js",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.24.3"
  },
  "devDependencies": {
    "@types/node": "^22.17.0",
    "typescript": "^5.4.2"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "inspector",
    "testing",
    "debugging"
  ],
  "license": "MIT"
}
